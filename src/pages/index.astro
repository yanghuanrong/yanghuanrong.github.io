---
import { getCollection } from 'astro:content'
import JsonLd from '../components/JsonLd.astro'
import ProjectCard from '../components/ProjectCard.astro'
import PhotoStack from '../components/react/PhotoStack.tsx'
import { DrivePhrase, HopPhrase, RolePhrase, ShutterPhrase, WavePhrase } from '../components/react/HeroAccent.tsx'
import { formatDate, projects, SITE_DESCRIPTION, socials, techIcons } from '../consts'
import ContribList from '../components/ContribList.astro'
import TechPile from '../components/react/TechPile.tsx'
import Base from '../layouts/Base.astro'

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)
---

<Base title="杨焕荣" description={SITE_DESCRIPTION}>
  <JsonLd slot="head" />
  <section class="hero">
    <h1>杨焕荣</h1>
    <p>
      我是一名
      <RolePhrase client:visible>设计工程师</RolePhrase>
      ，做过视觉、App 界面、产品和工程。
    </p>
    <p>
      我热衷于打造令人愉悦的界面，以及那些流畅又充满人性化体验的产品。专注于钻研 UI 组件 API、设计系统模式、排版设计和动画效果。
    </p>
    <p>
      兴趣广泛，
      <HopPhrase client:visible text="健身" />
      、
      <WavePhrase client:visible>游泳</WavePhrase>
      、
      <DrivePhrase client:visible>驾驶</DrivePhrase>
      ，在做技术之前，还曾学习过
      <ShutterPhrase client:visible>摄影</ShutterPhrase>
      。
      <PhotoStack client:load />
    </p>
    <ul class="socials">
      {
        socials.map((item) => (
          <li>
            <a
              href={item.href}
              target={item.href.startsWith('http') ? '_blank' : undefined}
              rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              {item.name}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <h2 class="section-title">项目</h2>
  <ul class="project-list">
    {
      projects.map((item) => (
        <li>
          <ProjectCard project={item} />
        </li>
      ))
    }
  </ul>

  <h2 class="section-title">贡献过</h2>
  <ContribList />

  <h2 class="section-title">文章</h2>
  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <a class="post-title" href={`/blog/${post.id}/`}>
            {post.data.title}
          </a>
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        </li>
      ))
    }
  </ul>
  <a class="see-all" href="/blog/">查看全部 →</a>

  <TechPile client:visible icons={techIcons} />
</Base>
