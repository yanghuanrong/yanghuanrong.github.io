---
import { getCollection } from 'astro:content'
import { formatDate } from '../../consts'
import PostTitleMorph from '../../components/PostTitleMorph.astro'
import Base from '../../layouts/Base.astro'

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)
---

<Base title="文章" description="杨焕荣写过的笔记。构建、计算、以及那些被验证过的前端判断。">
  <h1 class="page-title">文章</h1>
  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <PostTitleMorph slug={post.id} title={post.data.title} href={`/blog/${post.id}/`} />
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        </li>
      ))
    }
  </ul>
</Base>
