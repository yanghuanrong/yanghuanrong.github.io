---
import { Image } from 'astro:assets'
import ThemeToggle from './react/ThemeToggle.tsx'
import avatar from '../assets/avatar.jpg'
import { SITE_TITLE } from '../consts'

const pathname = Astro.url.pathname

const links = [
  { href: '/blog/', label: '文章' },
  { href: '/projects/', label: '项目' },
]

const isCurrent = (href: string) => pathname === href || pathname.startsWith(href)
---

<header class="site-header wrap">
  <a href="/" aria-label={SITE_TITLE}>
    <Image
      class="avatar"
      src={avatar}
      alt={SITE_TITLE}
      width={56}
      height={56}
      densities={[1, 2]}
    />
  </a>
</header>

<nav class="site-dock" aria-label="主导航">
  <div class="site-dock-nav">
    <div class="site-dock-group">
      {
        links.map((link) => (
          <a
            class="site-dock-link"
            href={link.href}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </div>
    <div class="site-dock-group site-dock-group--aside">
      <ThemeToggle client:load />
    </div>
  </div>
</nav>

<script>
  let dockPinCleanup: (() => void) | undefined

  function pinDock() {
    dockPinCleanup?.()

    const dock = document.querySelector('.site-dock')
    if (!(dock instanceof HTMLElement)) return

    const sync = () => {
      const anchor = document.querySelector('.tech-pile-brand')
      if (!(anchor instanceof HTMLElement)) {
        dock.style.transform = 'translate(-50%, 0)'
        return
      }

      const dockHeight = dock.offsetHeight
      const bottomGap = Number.parseFloat(getComputedStyle(dock).bottom) || 20
      const restLift = 200
      const fixedTop = window.innerHeight - bottomGap - dockHeight
      const shift = Math.min(0, anchor.getBoundingClientRect().top - restLift - fixedTop)
      dock.style.transform = `translate(-50%, ${shift}px)`
    }

    sync()
    window.addEventListener('scroll', sync, { passive: true })
    window.addEventListener('resize', sync)
    dockPinCleanup = () => {
      window.removeEventListener('scroll', sync)
      window.removeEventListener('resize', sync)
    }
  }

  pinDock()
  document.addEventListener('astro:page-load', pinDock)
</script>
