---
import { Image } from 'astro:assets'
import ThemeToggle from './react/ThemeToggle.tsx'
import AvatarEye from './react/AvatarEye.tsx'
import avatar from '../assets/avatar.webp'
import { SITE_TITLE } from '../consts'

const pathname = Astro.url.pathname

const links = [
  {
    href: '/',
    label: '首页',
    icon: 'home',
  },
  {
    href: '/blog/',
    label: '文章',
    icon: 'post',
  },
  {
    href: '/projects/',
    label: '项目',
    icon: 'project',
  },
] as const

const isCurrent = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(href)
---

<header class="site-header wrap">
  <a class="avatar-link" href="/" aria-label={SITE_TITLE}>
    <span class="avatar-frame">
      <Image
        class="avatar"
        src={avatar}
        alt={SITE_TITLE}
        width={56}
        height={56}
        densities={[1, 2]}
      />
      <AvatarEye client:load />
    </span>
  </a>
</header>

<nav class="site-dock" aria-label="主导航">
  <div class="site-dock-nav">
    <div class="site-dock-group">
      {
        links.map((link) => (
          <a
            class:list={['site-dock-item', { 'is-current': isCurrent(link.href) }]}
            href={link.href}
            aria-label={link.label}
            data-tooltip={link.label}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
          >
            {link.icon === 'home' ? (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="M4.75 10.5 12 4.75l7.25 5.75V19.5A1.25 1.25 0 0 1 18 20.75h-3.25v-5.5h-5.5v5.5H6A1.25 1.25 0 0 1 4.75 19.5V10.5Z"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linejoin="round"
                />
              </svg>
            ) : link.icon === 'post' ? (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="M7.5 5.25h5.75L18 9.9v9.35A1.25 1.25 0 0 1 16.75 20.5h-9.5A1.25 1.25 0 0 1 6 19.25V6.5A1.25 1.25 0 0 1 7.25 5.25H7.5Z"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linejoin="round"
                />
                <path
                  d="M13 5.4V10h4.7"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linejoin="round"
                />
                <path
                  d="M9.25 13h5.5M9.25 16.25H13"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                />
              </svg>
            ) : (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect
                  x="4.75"
                  y="5.5"
                  width="6.25"
                  height="6.25"
                  rx="1.4"
                  stroke="currentColor"
                  stroke-width="1.7"
                />
                <rect
                  x="13"
                  y="5.5"
                  width="6.25"
                  height="6.25"
                  rx="1.4"
                  stroke="currentColor"
                  stroke-width="1.7"
                />
                <rect
                  x="4.75"
                  y="13.75"
                  width="6.25"
                  height="6.25"
                  rx="1.4"
                  stroke="currentColor"
                  stroke-width="1.7"
                />
                <rect
                  x="13"
                  y="13.75"
                  width="6.25"
                  height="6.25"
                  rx="1.4"
                  stroke="currentColor"
                  stroke-width="1.7"
                />
              </svg>
            )}
            <span class="site-dock-dot" aria-hidden="true" />
          </a>
        ))
      }
    </div>
    <div class="site-dock-group site-dock-group--aside">
      <ThemeToggle client:load />
    </div>
  </div>
</nav>
