---
import { contributions } from '../consts'
---

<ul class="contrib-list">
  {
    contributions.map((item) => (
      <li>
        <a href={item.href} target="_blank" rel="noopener noreferrer">
          <span class="contrib-repo">
            {item.repo}
            <svg
              class="contrib-ext"
              width="12"
              height="12"
              viewBox="0 0 12 12"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M3.5 2.5h6v6M9.5 2.5 2.5 9.5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
        </a>
        <span class="contrib-note">{item.note}</span>
      </li>
    ))
  }
</ul>
