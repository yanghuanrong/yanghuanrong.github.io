---
import { contributions } from '../consts'
import { formatCount, withContributionStats } from '../lib/github'

const items = await withContributionStats(contributions)
---

<ul class="contrib-list">
  {
    items.map((item) => (
      <li>
        <a href={item.href} target="_blank" rel="noopener noreferrer">
          <span class="contrib-copy">
            <span class="contrib-repo">
              {item.repo}
              <svg
                class="contrib-ext"
                width="12"
                height="12"
                viewBox="0 0 12 12"
                aria-hidden="true"
                focusable="false"
              >
                <path
                  d="M3.5 2.5h6v6M9.5 2.5 2.5 9.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
            <span class="contrib-note">{item.note}</span>
          </span>
          {
            item.stars != null && item.forks != null ? (
              <span class="contrib-stats">
                <span>★ {formatCount(item.stars)}</span>
                <span>Fork {formatCount(item.forks)}</span>
              </span>
            ) : null
          }
        </a>
      </li>
    ))
  }
</ul>
