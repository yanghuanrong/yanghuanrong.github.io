---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import type { Project } from '../consts'
import eprotekCover from '../assets/projects/eprotek-cover.jpg'
import hydrogenCover from '../assets/projects/hydrogen-cover.jpg'
import relaxUiCover from '../assets/projects/relax-ui-cover.jpg'
import relaxPlusCover from '../assets/projects/relax-plus-cover.jpg'

const covers: Record<string, ImageMetadata> = {
  eprotek: eprotekCover,
  hydrogen: hydrogenCover,
  'relax-ui': relaxUiCover,
  'relax-plus': relaxPlusCover,
}

interface Props {
  project: Project
}

const { project } = Astro.props
const isExternal = Boolean(project.href?.startsWith('http'))
const coverImage = project.coverImage ? covers[project.coverImage] : undefined
---

<article class="project-card">
  {
    coverImage ? (
      <Image
        class="project-cover project-cover--image"
        src={coverImage}
        alt=""
        widths={[640, 960, 1280]}
        sizes="(max-width: 640px) 100vw, 640px"
      />
    ) : (
      <span class="project-cover" style={`--cover: ${project.cover}`}>
        {project.initial}
      </span>
    )
  }
  {
    project.href ? (
      <a
        class="project-name"
        href={project.href}
        {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
      >
        {project.name}
        {
          isExternal ? (
            <svg
              class="project-ext"
              width="12"
              height="12"
              viewBox="0 0 12 12"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M3.5 2.5h6v6M9.5 2.5 2.5 9.5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          ) : null
        }
      </a>
    ) : (
      <strong class="project-name">{project.name}</strong>
    )
  }
  <span class="desc">{project.desc}</span>
</article>
