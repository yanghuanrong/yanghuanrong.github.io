---
import JsonLd from '../components/JsonLd.astro'
import PostTitleMorph from '../components/PostTitleMorph.astro'
import { formatDate } from '../consts'
import Base from './Base.astro'

interface Props {
  title: string
  description: string
  pubDate: Date
  updatedDate?: Date
  slug: string
}

const { title, description, pubDate, updatedDate, slug } = Astro.props
---

<Base title={title} description={description} type="article">
  <JsonLd slot="head" type="article" title={title} description={description} datePublished={pubDate} />
  <article class="prose post-view slide-enter-content">
    <PostTitleMorph slug={slug} title={title} />
    <p class="meta">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      {updatedDate && <span> · Updated {formatDate(updatedDate)}</span>}
    </p>
    <div class="prose-body">
      <slot />
    </div>
  </article>
</Base>
