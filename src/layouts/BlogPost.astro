---
import JsonLd from '../components/JsonLd.astro'
import PostTitleMorph from '../components/PostTitleMorph.astro'
import PostToc, { type TocHeading } from '../components/PostToc.astro'
import { formatDate } from '../consts'
import Base from './Base.astro'

interface Props {
  title: string
  description: string
  pubDate: Date
  updatedDate?: Date
  slug: string
  headings: TocHeading[]
}

const { title, description, pubDate, updatedDate, slug, headings } = Astro.props
---

<Base title={title} description={description} type="article" animate={false}>
  <JsonLd slot="head" type="article" title={title} description={description} datePublished={pubDate} />
  <div class="post-layout">
    <PostToc title={title} headings={headings} />
    <article class="prose post-view slide-enter-content">
      <div id="top" class="post-intro">
        <PostTitleMorph slug={slug} title={title} />
        <p class="meta">
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          {updatedDate && <span> · Updated {formatDate(updatedDate)}</span>}
        </p>
      </div>
      <div class="prose-body">
        <slot />
      </div>
    </article>
  </div>
</Base>
