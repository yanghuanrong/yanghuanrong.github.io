---
import JsonLd from '../components/JsonLd.astro'
import { formatDate } from '../consts'
import Base from './Base.astro'

interface Props {
  title: string
  description: string
  pubDate: Date
  updatedDate?: Date
}

const { title, description, pubDate, updatedDate } = Astro.props
---

<Base title={title} description={description} type="article">
  <JsonLd slot="head" type="article" title={title} description={description} datePublished={pubDate} />
  <article class="prose">
    <h1>{title}</h1>
    <p class="meta">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      {updatedDate && <span> · Updated {formatDate(updatedDate)}</span>}
    </p>
    <slot />
  </article>
</Base>
